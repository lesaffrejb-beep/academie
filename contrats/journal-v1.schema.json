{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academie.local/contrats/journal-v1.schema.json",
  "title": "Ligne de journal v1 (proposition du 02/09/2026)",
  "description": "Une ligne = un événement, append-only. Le serveur n'écrit jamais dans le journal d'un joueur ; il en fait l'union. L'état se recalcule toujours depuis ces lignes. Migration du journal v0 (etat/<profil>/revues.jsonl) : mode 'flash' devient mode 'revision' avec format 'seance' ; les lignes du quiz gardent origine et stabilite_forcee ; nonce = SHA-256 de la ligne d'origine ; voir CONTRAT-CARTE-V2.md §5.",
  "type": "object",
  "required": [
    "quand",
    "mode",
    "nonce"
  ],
  "properties": {
    "quand": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "revision",
        "quiz",
        "examen",
        "erreur",
        "seance",
        "synthese",
        "signalement"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "description": "identifiant aléatoire côté client ; l'union se fait sur (profil, quand, mode, nonce)"
    },
    "carte": {
      "type": "string"
    },
    "note": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "format": {
      "enum": [
        "seance",
        "domaine",
        "etude",
        "journee",
        "epreuve",
        "hasard",
        "defi"
      ]
    },
    "duree_ms": {
      "type": "integer",
      "minimum": 0
    },
    "confiance": {
      "type": "boolean"
    },
    "stabilite_forcee": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "origine": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "dossier": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cartes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raison": {
      "type": "string",
      "maxLength": 200
    },
    "jour": {
      "enum": [
        "fondations",
        "cours",
        "terrain",
        "exploration",
        "etude",
        "libre"
      ]
    },
    "graine": {
      "type": "integer"
    },
    "cap": {
      "type": "string",
      "description": "le domaine choisi par le joueur, s'il en a choisi un"
    },
    "banque_version": {
      "type": "string"
    },
    "moteur_version": {
      "type": "string"
    },
    "chapitre": {
      "type": "string"
    },
    "attendus_coches": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "motif": {
      "type": "string",
      "maxLength": 300,
      "description": "signalement : pourquoi la carte est fausse (facultatif)"
    },
    "etude_etape": {
      "type": "string",
      "enum": [
        "tentative",
        "principe",
        "exercices",
        "synthese",
        "grille",
        "terminee"
      ]
    },
    "contenu_version": {
      "type": "integer",
      "minimum": 1
    },
    "reponse_libre": {
      "type": "string",
      "maxLength": 5000
    },
    "aide_utilisee": {
      "type": "boolean"
    },
    "exercice_index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "revision"
          }
        }
      },
      "then": {
        "required": [
          "carte",
          "note",
          "format"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "quiz"
          }
        }
      },
      "then": {
        "required": [
          "carte",
          "note",
          "stabilite_forcee",
          "origine"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "examen"
          }
        }
      },
      "then": {
        "required": [
          "score"
        ],
        "anyOf": [
          {
            "required": [
              "region"
            ]
          },
          {
            "required": [
              "dossier"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "erreur"
          }
        }
      },
      "then": {
        "required": [
          "carte"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "seance"
          }
        }
      },
      "then": {
        "required": [
          "format",
          "graine",
          "banque_version",
          "moteur_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "synthese"
          }
        }
      },
      "then": {
        "required": [
          "chapitre",
          "attendus_coches"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "signalement"
          }
        }
      },
      "then": {
        "required": [
          "carte"
        ]
      }
    }
  ]
}
