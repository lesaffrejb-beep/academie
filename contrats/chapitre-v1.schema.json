{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academie.local/contrats/chapitre-v1.schema.json",
  "title": "Chapitre v1 (proposition du 02/09/2026)",
  "type": "object",
  "required": ["id", "titre", "domaine", "branche", "niveau", "prerequis", "objectifs", "amorce", "lecon", "synthese", "sources", "provenance", "statut", "partage", "verifie", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"},
    "provenance": {"$ref": "carte-v2.schema.json#/properties/provenance"},
    "titre": {"type": "string", "minLength": 3},
    "domaine": {"type": "string"},
    "branche": {"type": "string"},
    "niveau": {"type": "integer", "minimum": 1, "maximum": 5},
    "prerequis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ponts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "objectifs": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 10}},
    "amorce": {
      "type": "object", "required": ["question", "reponse_attendue"], "additionalProperties": false,
      "properties": {"question": {"type": "string"}, "aide": {"type": "string"}, "reponse_attendue": {"type": "string"}, "image": {"type": "string"}}
    },
    "lecon": {"type": "string", "minLength": 1200, "maxLength": 6000, "description": "Markdown, 300 à 800 mots, paraphrase et liens, un exemple travaillé"},
    "synthese": {
      "type": "object", "required": ["consigne", "attendus"], "additionalProperties": false,
      "properties": {"consigne": {"type": "string"}, "attendus": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "string"}}}
    },
    "cartes": {"type": "array", "items": {"$ref": "carte-v2.schema.json"}},
    "cartes_fichier": {"type": "string", "description": "pendant la migration : un fichier v1 dont les cartes portent ce chapitre"},
    "sources": {"type": "array", "minItems": 0, "items": {"$ref": "carte-v2.schema.json#/properties/source/items"}, "description": "au moins une sauf provenance.sans_source"},
    "satellite": {"type": "boolean", "default": false},
    "rattachement_propose": {"type": "string"},
    "rattache_le": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "statut": {"enum": ["brouillon", "valide", "signale", "perime"]},
    "partage": {"enum": ["banque", "interne", "perso"]},
    "verifie": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "verifie_par": {"type": "string"},
    "peremption": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1},
    "remplace": {"type": "string", "description": "identifiant de la version précédente si le chapitre a été réécrit"},
    "historique": {"type": "array", "items": {"type": "object"}}
  },
  "anyOf": [{"required": ["cartes"]}, {"required": ["cartes_fichier"]}]
}
