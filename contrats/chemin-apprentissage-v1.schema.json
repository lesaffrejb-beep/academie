{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chemin d'apprentissage v1 : brouillon instruit par un agent",
  "type": "object", "additionalProperties": false,
  "required": ["version", "statut", "demande", "cible_observable", "metier", "ancrage", "prerequis", "diagnostic", "sources", "etapes"],
  "properties": {
    "version": {"const": 1}, "statut": {"const": "brouillon"},
    "demande": {"$ref": "#/$defs/texte"}, "cible_observable": {"$ref": "#/$defs/texte"},
    "metier": {"$ref": "#/$defs/id"}, "ancrage": {"$ref": "#/$defs/lien"},
    "prerequis": {"type": "array", "items": {"$ref": "#/$defs/acquis"}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["productions", "reussite", "echec"], "properties": {
      "productions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["consigne", "criteres"], "properties": {"consigne": {"$ref": "#/$defs/texte"}, "criteres": {"$ref": "#/$defs/textes"}}}},
      "reussite": {"$ref": "#/$defs/textes"}, "echec": {"$ref": "#/$defs/textes"}
    }},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "etapes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/etape"}},
    "contexte": {"type": "object", "description": "Inventaire de préparation, jamais preuve d'acquis ni contenu à servir."}
  },
  "$defs": {
    "texte": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "textes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/texte"}},
    "lien": {"type": "object", "additionalProperties": false, "required": ["chapitre", "justification"], "properties": {"chapitre": {"$ref": "#/$defs/texte"}, "justification": {"$ref": "#/$defs/texte"}}},
    "acquis": {"type": "object", "additionalProperties": false, "required": ["notion", "etat"], "properties": {
      "notion": {"$ref": "#/$defs/texte"}, "etat": {"enum": ["inconnu", "declare", "observe"]}, "chapitre": {"$ref": "#/$defs/texte"},
      "preuve": {"$ref": "#/$defs/texte"}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }, "allOf": [{"if": {"properties": {"etat": {"const": "observe"}}}, "then": {"required": ["preuve", "date"]}}]},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "titre", "statut"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "titre": {"$ref": "#/$defs/texte"}, "statut": {"enum": ["presente", "a_trouver"]},
      "url": {"type": "string", "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"}, "empreinte": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "chemin_original": {"$ref": "#/$defs/texte"}, "manque": {"$ref": "#/$defs/texte"}
    }, "allOf": [{"if": {"properties": {"statut": {"const": "presente"}}}, "then": {"required": ["url", "empreinte", "chemin_original"]}, "else": {"required": ["manque"]}}]},
    "exercice": {"type": "object", "additionalProperties": false, "required": ["format", "consigne", "justification", "criteres", "sources"], "properties": {
      "format": {"enum": ["flash", "qcm", "photo", "relier", "datation", "plan", "cas", "libre", "role", "dessin", "feuille-blanche", "synthese", "lecture", "ecoute"]},
      "consigne": {"$ref": "#/$defs/texte"}, "justification": {"$ref": "#/$defs/texte"}, "criteres": {"$ref": "#/$defs/textes"}, "sources": {"$ref": "#/$defs/textes"},
      "support": {"type": "object", "additionalProperties": false, "required": ["chemin", "justification"], "properties": {"chemin": {"$ref": "#/$defs/texte"}, "justification": {"$ref": "#/$defs/texte"}}}
    }},
    "etape": {"type": "object", "additionalProperties": false,
      "required": ["id", "titre", "niveau", "justification_niveau", "dependances", "disponibilite", "transversalites", "notions", "sources", "exercices", "transfert", "reprise_echec"],
      "oneOf": [{"required": ["chapitre"], "not": {"required": ["proposition"]}}, {"required": ["proposition"], "not": {"required": ["chapitre"]}}],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "titre": {"$ref": "#/$defs/texte"}, "niveau": {"type": "integer", "minimum": 1, "maximum": 5},
        "justification_niveau": {"$ref": "#/$defs/texte"}, "dependances": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "chapitre": {"$ref": "#/$defs/texte"}, "proposition": {"type": "object", "additionalProperties": false, "required": ["titre", "justification"], "properties": {"titre": {"$ref": "#/$defs/texte"}, "justification": {"$ref": "#/$defs/texte"}}},
        "disponibilite": {"enum": ["disponible", "a_construire"]}, "transversalites": {"type": "array", "items": {"$ref": "#/$defs/lien"}},
        "notions": {"$ref": "#/$defs/textes"}, "sources": {"$ref": "#/$defs/textes"}, "exercices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exercice"}},
        "transfert": {"type": "object", "additionalProperties": false, "required": ["cas_nouveau", "criteres"], "properties": {"cas_nouveau": {"$ref": "#/$defs/texte"}, "criteres": {"$ref": "#/$defs/textes"}}},
        "reprise_echec": {"type": "object", "additionalProperties": false, "required": ["consigne", "etapes"], "properties": {"consigne": {"$ref": "#/$defs/texte"}, "etapes": {"$ref": "#/$defs/textes"}}}
      }
    }
  }
}
