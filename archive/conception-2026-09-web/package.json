{
  "name": "academie-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Client v2 de l'Academie. Jetable : il peut etre reecrit sans toucher au moteur, a la banque ni au journal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test tests/publication.test.mjs",
    "test:publication": "node --test tests/publication.test.mjs",
    "test:watch": "vitest",
    "parite": "vitest run src/moteur/parite.test.ts",
    "vecteurs": "python3 ../app/vecteurs_fsrs.py",
    "e2e": "playwright test",
    "e2e:telephone": "playwright test --project=telephone"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "dexie": "4.0.11",
    "lucide-react": "1.40.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
